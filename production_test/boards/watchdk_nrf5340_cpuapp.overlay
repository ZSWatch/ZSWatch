/* The production test updates the firmware of the HR extension hub. */
#include "../../app/boards/zswatch/watchdk/watchdk_nrf5340_cpuapp_hr.overlay"

/ {
    chosen {
        zephyr,console = &uart0;
    };

};
&i2c1 {
    // Flash buffer size is needed for the I2C bootloader to flash the firmware
    zephyr,flash-buf-max-size = <8250>;
};
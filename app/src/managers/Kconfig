menu "Managers"
    menu "Power Manager"
        module = ZSW_PWR_MANAGER
        module-str = ZSW_PWR_MANAGER
        source "subsys/logging/Kconfig.template.log_config"
    endmenu

    menu "XIP Manager"
        depends on ZSW_XIP

        module = ZSW_XIP_MANAGER
        module-str = ZSW_XIP_MANAGER
        source "subsys/logging/Kconfig.template.log_config"
    endmenu

    menu "Mic Manager"
        config ZSW_MIC
            bool
            prompt "Enable Mic functionality"
            select AUDIO
            select AUDIO_DMIC
            default n

        config ZSW_MIC_DEFAULT_GAIN
            int "Default PDM microphone gain (0-80)"
            default 40
            range 0 80
            depends on ZSW_MIC
            help
                PDM gain register value applied at mic init.
                0 = mute (-20 dB), 40 = 0 dB (default), 80 = +20 dB.
                Can be changed at runtime via zsw_microphone_set_gain()
                or the 'mic gain_set' shell command.

        module = ZSW_MIC_MANAGER
        module-str = ZSW_MIC_MANAGER
        source "subsys/logging/Kconfig.template.log_config"
    endmenu
endmenu

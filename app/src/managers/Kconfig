menu "Managers"
    config ZSW_HR_MANAGER
        bool "Manage background heart-rate acquisition"
        default y
        depends on DT_HAS_MAXIM_MAX32664C_ENABLED && SETTINGS
        help
          Decides when the heart rate sensor runs: periodic background measurements,
          continuous measurement while moving, or manual one-shot measurements.

    if ZSW_HR_MANAGER
    config ZSW_HR_BACKGROUND_INTERVAL_SECONDS
        int "Background HR interval (seconds)"
        default 300
        range 30 3600
        help
          Time between the start of two background measurements, in background mode.
          Measurements only start while the watch is moving (worn). Each measurement
          runs the optical sensor, about 1.2 mA extra, until a heart rate is accepted
          (typically 10-20 s) or ZSW_HR_ATTEMPT_TIMEOUT_SECONDS. With the default 300 s,
          a 15 s measurement adds about 60 uA on average; halving the interval doubles it.

    config ZSW_HR_ATTEMPT_TIMEOUT_SECONDS
        int "Maximum one-shot HR attempt (seconds)"
        default 45
        range 5 120
        help
          Longest time a background or manual measurement keeps the optical sensor on
          without getting an accepted heart rate. Also how long continuous mode waits
          for a sensor report before restarting the sensor. Bounds the worst case power
          use of a failing measurement, for example with a loose fit.

    config ZSW_HR_MIN_CONFIDENCE
        int "Minimum accepted HR confidence"
        default 75
        range 1 100
        help
          Minimum confidence (percent) reported by the sensor hub for a heart rate to be
          accepted and published.

    config ZSW_HR_GOOD_REPORTS
        int "Consecutive good reports before accepting HR"
        default 3
        range 1 10
        help
          Number of consecutive reports (one per second) with skin contact and at least
          ZSW_HR_MIN_CONFIDENCE before a heart rate is accepted. Higher values reject
          more noise but keep the sensor on longer per measurement.
    endif

    menu "Power Manager"
        module = ZSW_PWR_MANAGER
        module-str = ZSW_PWR_MANAGER
        source "subsys/logging/Kconfig.template.log_config"
    endmenu

    menu "XIP Manager"
        depends on ZSW_XIP

        module = ZSW_XIP_MANAGER
        module-str = ZSW_XIP_MANAGER
        source "subsys/logging/Kconfig.template.log_config"
    endmenu

    menu "Mic Manager"
        config ZSW_MIC
            bool
            prompt "Enable Mic functionality"
            select AUDIO
            select AUDIO_DMIC
            default n

        config ZSW_MIC_DEFAULT_GAIN
            int "Default PDM microphone gain (0-80)"
            default 40
            range 0 80
            depends on ZSW_MIC
            help
                PDM gain register value applied at mic init.
                0 = mute (-20 dB), 40 = 0 dB (default), 80 = +20 dB.
                Can be changed at runtime via zsw_microphone_set_gain()
                or the 'mic gain_set' shell command.

        module = ZSW_MIC_MANAGER
        module-str = ZSW_MIC_MANAGER
        source "subsys/logging/Kconfig.template.log_config"
    endmenu
endmenu

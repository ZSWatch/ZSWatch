menu "Watchface"
    config WATCHFACE_DIGITAL
        bool
        prompt "Add digital watchface"
        default y

    config WATCHFACE_DIGITAL_MINIMAL
        bool
        prompt "Add digital minimal watchface"
        default y

    config WATCHFACE_MINIMAL
        bool
        prompt "Add minimal watchface"
        default y

    config WATCHFACE_LIVING_SKY
        bool
        prompt "Add Living Sky watchface (animated weather and sky tint)"
        default y

    config WATCHFACE_SNOW
        bool
        prompt "Add Snow watchface (digits of snow that fall the way the watch is held)"
        default y

    config WATCHFACE_DIORAMA
        bool
        prompt "Add Diorama watchface (a landscape with depth that follows the sun and the weather)"
        default y

endmenu
